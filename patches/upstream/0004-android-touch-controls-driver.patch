+// goliath/controller/touch_input.cpp
+// Copyright Rien Gupta <rgupta9@scu.edu>
+// BSD 3-Clause
+
+#include "goliath/controller/touch_input.h"
+
+#include <SDL3/SDL.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <vector>
+
+#include <rex/input/device.h>
+#include <rex/input/input.h>
+#include <rex/input/input_driver.h>
+#include <rex/system/xtypes.h>
+
+namespace eot::controller {
+namespace {
+
+// A button zone in normalized window coordinates (0..1, landscape).
+// Data-driven so the layout can be tuned without touching the logic.
+struct ButtonZone {
+  float x;
+  float y;
+  float radius;    // activation radius (fraction of the window width)
+  uint16_t button; // rex::input::X_INPUT_GAMEPAD_* bit (0 for the trigger zones)
+  bool is_trigger;
+  bool trigger_left; // true: LT, false: RT
+};
+
+constexpr ButtonZone kButtonZones[] = {
+    // D-pad (menus) - left part of the right half.
+    {0.52f, 0.50f, 0.11f, rex::input::X_INPUT_GAMEPAD_DPAD_UP, false, false},
+    {0.52f, 0.76f, 0.11f, rex::input::X_INPUT_GAMEPAD_DPAD_DOWN, false, false},
+    {0.40f, 0.63f, 0.11f, rex::input::X_INPUT_GAMEPAD_DPAD_LEFT, false, false},
+    {0.64f, 0.63f, 0.11f, rex::input::X_INPUT_GAMEPAD_DPAD_RIGHT, false, false},
+    // Face buttons - right cluster.
+    {0.87f, 0.76f, 0.11f, rex::input::X_INPUT_GAMEPAD_A, false, false},
+    {0.96f, 0.63f, 0.11f, rex::input::X_INPUT_GAMEPAD_B, false, false},
+    {0.78f, 0.63f, 0.11f, rex::input::X_INPUT_GAMEPAD_X, false, false},
+    {0.87f, 0.50f, 0.11f, rex::input::X_INPUT_GAMEPAD_Y, false, false},
+    // Shoulders.
+    {0.44f, 0.28f, 0.09f, rex::input::X_INPUT_GAMEPAD_LEFT_SHOULDER, false, false},
+    {0.95f, 0.28f, 0.09f, rex::input::X_INPUT_GAMEPAD_RIGHT_SHOULDER, false, false},
+    // Triggers (top edge of the right half).
+    {0.60f, 0.16f, 0.09f, 0, true, true},
+    {0.76f, 0.16f, 0.09f, 0, true, false},
+    // System buttons.
+    {0.68f, 0.05f, 0.07f, rex::input::X_INPUT_GAMEPAD_BACK, false, false},
+    {0.84f, 0.05f, 0.07f, rex::input::X_INPUT_GAMEPAD_START, false, false},
+};
+
+// Left of this fraction of the width is the virtual left stick.
+constexpr float kLeftZoneWidth = 0.38f;
+// Stick travel: the distance (as a fraction of the width) for full deflection.
+constexpr float kStickTravel = 0.12f;
+
+struct Finger {
+  float x = 0.0f;
+  float y = 0.0f;
+};
+
+class TouchInputDriver final : public rex::input::InputDriver {
+ public:
+  TouchInputDriver() : rex::input::InputDriver(nullptr, 0) {}
+  ~TouchInputDriver() override { SDL_RemoveEventWatch(WatchCallback, this); }
+
+  X_STATUS Setup() override {
+    // The watch runs on the UI thread inside SDL's event loop, so the finger
+    // map is only ever mutated there; GetDeviceState locks the same mutex.
+    SDL_AddEventWatch(WatchCallback, this);
+    return X_STATUS_SUCCESS;
+  }
+
+  void EnumerateDevices(std::vector<rex::input::DeviceInfo>& out) override {
+    rex::input::DeviceInfo info;
+    info.id = rex::input::DeviceId{1};
+    info.name = "Touch Controls (virtual)";
+    info.guid = "eot-touch-virtual-pad";
+    info.synthetic = true;
+    out.push_back(info);
+  }
+
+  X_RESULT GetDeviceState(rex::input::DeviceId id,
+                          rex::input::X_INPUT_STATE* out_state) override {
+    if (id != rex::input::DeviceId{1}) {
+      return X_ERROR_DEVICE_NOT_CONNECTED;
+    }
+    std::memset(out_state, 0, sizeof(*out_state));
+
+    uint16_t buttons = 0;
+    uint8_t left_trigger = 0;
+    uint8_t right_trigger = 0;
+    int16_t thumb_lx = 0;
+    int16_t thumb_ly = 0;
+
+    {
+      std::lock_guard<std::mutex> guard(mutex_);
+      int fingers_left = 0;
+      int fingers_right = 0;
+      for (const auto& [finger_id, finger] : fingers_) {
+        if (finger.x < kLeftZoneWidth) {
+          ++fingers_left;
+          // The lowest finger id in the left zone drives the stick; its
+          // anchor is where it first appeared.
+          if (stick_finger_id_ < 0 || finger_id == stick_finger_id_) {
+            if (stick_finger_id_ < 0) {
+              stick_finger_id_ = finger_id;
+              stick_anchor_x_ = finger.x;
+              stick_anchor_y_ = finger.y;
+            }
+            const float dx = (finger.x - stick_anchor_x_) / kStickTravel;
+            const float dy = (finger.y - stick_anchor_y_) / kStickTravel;
+            const float len = std::sqrt(dx * dx + dy * dy);
+            const float scale = len > 1.0f ? 1.0f / len : 1.0f;
+            thumb_lx = static_cast<int16_t>(std::clamp(dx * scale * 32767.0f, -32768.0f, 32767.0f));
+            thumb_ly = static_cast<int16_t>(std::clamp(-dy * scale * 32767.0f, -32768.0f, 32767.0f));
+          }
+        } else {
+          ++fingers_right;
+          for (const ButtonZone& zone : kButtonZones) {
+            const float dx = (finger.x - zone.x) / zone.radius;
+            const float dy = (finger.y - zone.y) / zone.radius;
+            if (dx * dx + dy * dy <= 1.0f) {
+              if (zone.is_trigger) {
+                if (zone.trigger_left) {
+                  left_trigger = 0xFF;
+                } else {
+                  right_trigger = 0xFF;
+                }
+              } else {
+                buttons |= zone.button;
+              }
+              break;
+            }
+          }
+        }
+      }
+      if (fingers_left == 0) {
+        stick_finger_id_ = -1;
+      } else if (stick_finger_id_ >= 0) {
+        // Drop the stick anchor if its finger left the map.
+        bool found = false;
+        for (const auto& [finger_id, finger] : fingers_) {
+          if (finger_id == stick_finger_id_) {
+            found = true;
+            break;
+          }
+        }
+        if (!found) {
+          stick_finger_id_ = -1;
+        }
+      }
+      // A second simultaneous finger is a stick click (LS / RS).
+      if (fingers_left > 1) {
+        buttons |= rex::input::X_INPUT_GAMEPAD_LEFT_THUMB;
+      }
+      if (fingers_right > 1) {
+        buttons |= rex::input::X_INPUT_GAMEPAD_RIGHT_THUMB;
+      }
+    }
+
+    const uint32_t packet = ++packet_;
+    out_state->packet_number = packet;
+    out_state->gamepad.buttons = buttons;
+    out_state->gamepad.left_trigger = left_trigger;
+    out_state->gamepad.right_trigger = right_trigger;
+    out_state->gamepad.thumb_lx = thumb_lx;
+    out_state->gamepad.thumb_ly = thumb_ly;
+    // No right stick on the touch layout.
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT GetDeviceCapabilities(rex::input::DeviceId id, uint32_t /*flags*/,
+                                 rex::input::X_INPUT_CAPABILITIES* out_caps) override {
+    if (id != rex::input::DeviceId{1}) {
+      return X_ERROR_DEVICE_NOT_CONNECTED;
+    }
+    std::memset(out_caps, 0, sizeof(*out_caps));
+    out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+    out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+    out_caps->flags = 0;
+    out_caps->gamepad.buttons = 0xF3FF;
+    out_caps->gamepad.left_trigger = 0xFF;
+    out_caps->gamepad.right_trigger = 0xFF;
+    out_caps->gamepad.thumb_lx = static_cast<int16_t>(0xFFFFu);
+    out_caps->gamepad.thumb_ly = static_cast<int16_t>(0xFFFFu);
+    out_caps->gamepad.thumb_rx = static_cast<int16_t>(0xFFFFu);
+    out_caps->gamepad.thumb_ry = static_cast<int16_t>(0xFFFFu);
+    out_caps->vibration.left_motor_speed = 0xFFFFu;
+    out_caps->vibration.right_motor_speed = 0xFFFFu;
+    return X_ERROR_SUCCESS;
+  }
+
+  X_RESULT SetDeviceVibration(rex::input::DeviceId id,
+                              rex::input::X_INPUT_VIBRATION* /*vibration*/) override {
+    // No haptic device is associated with the virtual pad.
+    return id == rex::input::DeviceId{1} ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+
+  X_RESULT GetDeviceKeystroke(rex::input::DeviceId id, uint32_t /*flags*/,
+                              rex::input::X_INPUT_KEYSTROKE* /*out_keystroke*/) override {
+    return id == rex::input::DeviceId{1} ? X_ERROR_EMPTY : X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+
+ private:
+  static bool SDLCALL WatchCallback(void* userdata, SDL_Event* event) {
+    auto* self = static_cast<TouchInputDriver*>(userdata);
+    switch (event->type) {
+      case SDL_EVENT_FINGER_DOWN:
+      case SDL_EVENT_FINGER_MOTION: {
+        std::lock_guard<std::mutex> guard(self->mutex_);
+        self->fingers_[event->tfinger.fingerID] = {event->tfinger.x, event->tfinger.y};
+        break;
+      }
+      case SDL_EVENT_FINGER_UP:
+      case SDL_EVENT_FINGER_CANCELED: {
+        std::lock_guard<std::mutex> guard(self->mutex_);
+        self->fingers_.erase(event->tfinger.fingerID);
+        break;
+      }
+      default:
+        break;
+    }
+    return true;
+  }
+
+  std::mutex mutex_;
+  std::map<int64_t, Finger> fingers_;
+  int64_t stick_finger_id_ = -1;
+  float stick_anchor_x_ = 0.0f;
+  float stick_anchor_y_ = 0.0f;
+  std::atomic<uint32_t> packet_{0};
+};
+
+}  // namespace
+
+std::unique_ptr<rex::input::InputDriver> CreateTouchInputDriver() {
+  return std::make_unique<TouchInputDriver>();
+}
+
+}  // namespace eot::controller
