+// goliath/controller/touch_input.h
+// Copyright Rien Gupta <rgupta9@scu.edu>
+// BSD 3-Clause
+
+#pragma once
+
+#include <memory>
+
+namespace rex::input {
+class InputDriver;
+}
+
+namespace eot::controller {
+
+/// Virtual XInput gamepad driven by on-screen touch zones (Android).
+///
+/// The left part of the screen is a virtual left stick; the right part holds
+/// the buttons (D-pad, face buttons, shoulders, triggers, system buttons).
+/// The driver polls no SDL state from the calling thread - it consumes SDL
+/// touch events through an event watch (which runs on the UI thread) and keeps
+/// a mutex-protected finger map, so GetDeviceState is safe to call from the
+/// guest threads that poll XInput.
+///
+/// Button bits are the rex::input::X_INPUT_GAMEPAD_* values, which match
+/// kPadInputs[].bit in pad_actions.h one-to-one.
+std::unique_ptr<rex::input::InputDriver> CreateTouchInputDriver();
+
+}  // namespace eot::controller
