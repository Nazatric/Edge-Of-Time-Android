@@ -29,6 +29,35 @@
 set(REEOT_SHADER_INPUT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/assets/shaders" CACHE PATH
     "The game's shader containers, one per file, the shader cache is built from")
 
+# Host tools for cross builds. When cross-compiling (e.g. Android from an
+# x86_64 build machine), rexglue / pkztool / pkzprep / XenosRecomp are built for
+# the TARGET and cannot run on the build machine. Point these at native builds
+# of the same tools; empty means "use the target-built tool" (native builds).
+set(REEOT_HOST_REXGLUE "" CACHE FILEPATH "Native rexglue tool for cross builds")
+set(REEOT_HOST_PKZTOOL "" CACHE FILEPATH "Native pkztool for cross builds")
+set(REEOT_HOST_PKZPREP "" CACHE FILEPATH "Native pkzprep for cross builds")
+set(REEOT_HOST_XENOSRECOMP "" CACHE FILEPATH "Native XenosRecomp for cross builds")
+if(REEOT_HOST_REXGLUE)
+    set(REEOT_REXGLUE_CMD "${REEOT_HOST_REXGLUE}")
+else()
+    set(REEOT_REXGLUE_CMD "$<TARGET_FILE:rex::rexglue>")
+endif()
+if(REEOT_HOST_PKZTOOL)
+    set(REEOT_PKZTOOL_CMD "${REEOT_HOST_PKZTOOL}")
+else()
+    set(REEOT_PKZTOOL_CMD "pkztool")
+endif()
+if(REEOT_HOST_PKZPREP)
+    set(REEOT_PKZPREP_CMD "${REEOT_HOST_PKZPREP}")
+else()
+    set(REEOT_PKZPREP_CMD "pkzprep")
+endif()
+if(REEOT_HOST_XENOSRECOMP)
+    set(REEOT_XENOSRECOMP_CMD "${REEOT_HOST_XENOSRECOMP}")
+else()
+    set(REEOT_XENOSRECOMP_CMD "$<TARGET_FILE:XenosRecomp>")
+endif()
+
 include(generated/rexglue.cmake)
 # The macOS Vulkan staging in rexglue_setup_target() reads REXGLUE_ROOT.
 if(REXSDK_DIR AND NOT REXGLUE_ROOT)
