 std::filesystem::path GetExecutableFolder() {
+#if REX_PLATFORM_ANDROID
+  // Android has no process "executable" in the desktop sense: /proc/self/exe
+  // points at app_process, and the app's loadable modules (the runtime
+  // libraries, the guest GameLogic module) are extracted into the app's
+  // nativeLibraryDir. Resolve it through the JNI context registered by the app
+  // entry point (rex::android::RegisterJni).
+  if (JNIEnv* env = rex::android::GetThreadEnv()) {
+    jclass context_class = env->FindClass("android/content/Context");
+    jclass app_info_class = env->FindClass("android/content/pm/ApplicationInfo");
+    if (context_class && app_info_class) {
+      jmethodID get_application_info = env->GetMethodID(
+          context_class, "getApplicationInfo", "()Landroid/content/pm/ApplicationInfo;");
+      jfieldID native_library_dir =
+          env->GetFieldID(app_info_class, "nativeLibraryDir", "Ljava/lang/String;");
+      if (get_application_info && native_library_dir) {
+        jobject app_info =
+            env->CallObjectMethod(rex::android::GetContext(), get_application_info);
+        if (app_info) {
+          auto* dir = reinterpret_cast<jstring>(env->GetObjectField(app_info, native_library_dir));
+          std::filesystem::path result;
+          if (dir) {
+            const char* chars = env->GetStringUTFChars(dir, nullptr);
+            if (chars) {
+              result = std::filesystem::path(chars);
+              env->ReleaseStringUTFChars(dir, chars);
+            }
+            env->DeleteLocalRef(dir);
+          }
+          env->DeleteLocalRef(app_info);
+          if (!result.empty()) {
+            env->DeleteLocalRef(app_info_class);
+            env->DeleteLocalRef(context_class);
+            return result;
+          }
+        }
+      }
+    }
+    if (env->ExceptionCheck()) {
+      env->ExceptionClear();
+    }
+    if (app_info_class) {
+      env->DeleteLocalRef(app_info_class);
+    }
+    if (context_class) {
+      env->DeleteLocalRef(context_class);
+    }
+  }
+#endif
   return GetExecutablePath().parent_path();
 }
 
