<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Spider-Man: Edge of Time (ReXGlue recompilation) - Android port.

      No permissions are required: game files are provided by the user through
      the Storage Access Framework (ACTION_OPEN_DOCUMENT_TREE), and all writable
      data lives in the app's private directories.
    -->

    <!-- Vulkan 1.0+ is required to run the game. Not marked required so the APK
         remains installable on devices without Vulkan for diagnostics; the app
         checks at runtime and reports the missing capability. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />
    <!-- The game is a landscape experience. -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="true" />

    <application
        android:name=".EdgeOfTimeApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:isGame="true"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.EdgeOfTime">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
